{
  "manifest_version": 3,
  "name": "Sales Copilot (demo)",
  "version": "0.1.0",
  "description": "Suggests replies in the CRM inbox, grounded in what worked in closed-won conversations.",
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "https://app.revio.example/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://app.revio.example/*"],
      "js": ["content.js"],
      "css": ["panel.css"]
    }
  ]
}
