          "timeout": 15000
        }
      }
    },
    {
      "id": "review",
      "name": "Return human review item",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        520,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "label",
              "name": "label",
              "type": "string",
              "value": "={{ $json.label }}"
            },
            {
              "id": "review",
              "name": "requires_human_review",
              "type": "boolean",
              "value": true
            },
            {
              "id": "next",
              "name": "next_action",
              "type": "string",
              "value": "Review the classification before contacting a customer or updating a CRM."
